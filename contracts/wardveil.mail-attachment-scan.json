{
  "contract_version": "0.5.0",
  "consumer": "GoreeCloud Mail",
  "integration": "Wardveil Scan attachment consumer with bidirectional enforcement and durable minimized application provenance",
  "wardveil_runtime_contract_version": "0.1.0",
  "resource_type": "mail_attachment",
  "direct_clamav_access_allowed": false,
  "attachment_digest_binding_required": true,
  "authoritative_scan_record_required": true,
  "application_scan_result_field": "result",
  "obsolete_application_scan_result_field_rejected": "scan_result",
  "clean_requires_current_unexpired_evidence": true,
  "clean_requires_evidence_refs": true,
  "transport": {
    "source_compatible_wardveil_revision": "842d792c128906e70d41028e3153ea527c1d1899",
    "endpoint_path": "/v1/scan",
    "ipv4_loopback_http_only": true,
    "redirects_allowed": false,
    "default_caller_id": "goreecloud-mail",
    "key_scoped_request_signature_required": true,
    "signature_algorithm": "HMAC-SHA256-reference-transport",
    "signature_contract_version": "0.1.0",
    "signature_binds": [
      "caller_id",
      "key_id",
      "timestamp",
      "nonce",
      "action",
      "resource_type",
      "resource_id",
      "correlation_id",
      "size_bytes",
      "digest_sha256"
    ],
    "response_correlation_required": true,
    "response_resource_binding_required": true,
    "response_size_bounded": true,
    "production_service_identity_accepted": false,
    "distributed_replay_protection_accepted": false
  },
  "delivery_enforcement": {
    "wardveil_scan_client_required": true,
    "provider_bytes_scanned_before_downloadable_storage": true,
    "scan_action": "download",
    "only_current_clean_result_may_create_downloadable_record": true,
    "malicious_content_stored_for_download": false,
    "suspicious_content_stored_for_download": false,
    "unknown_content_stored_for_download": false,
    "unsupported_content_stored_for_download": false,
    "scanner_unavailable_fails_closed_before_storage": true,
    "stored_sha256_must_equal_scan_digest": true,
    "changed_during_scan_or_storage_fails_closed": true,
    "download_rechecks_scan_validity": true,
    "download_rechecks_stored_digest_binding": true,
    "process_restart_without_current_scan_provenance_fails_closed": true
  },
  "durable_scan_provenance": {
    "implemented": true,
    "scope": "incoming_download_cache",
    "storage": "private_attachment_sidecar_json",
    "schema_version": 1,
    "atomic_write": true,
    "file_mode": "0600",
    "size_bounded": true,
    "max_bytes": 65536,
    "integrity_sha256": true,
    "object_id_binding": true,
    "clean_only": true,
    "stores_scan_record_id": true,
    "stores_correlation_id": true,
    "stores_producer_id": true,
    "stores_observed_at": true,
    "stores_valid_until": true,
    "stores_content_digest": true,
    "stores_evidence_refs": true,
    "stores_raw_attachment_content": false,
    "stores_provider_credentials": false,
    "stores_wardveil_caller_secrets": false,
    "restart_rehydration": true,
    "missing_provenance_fails_closed": true,
    "corrupt_or_tampered_provenance_fails_closed": true,
    "evidence_expiry_enforced_after_restart": true,
    "cleanup_coordinated_with_attachment": true,
    "production_authenticated_provenance_store_accepted": false,
    "automatic_rescan_after_restart_implemented": false
  },
  "outgoing_write_enforcement": {
    "implemented": true,
    "actions": [
      "send",
      "draft"
    ],
    "attachment_writes_require_wardveil_gate": true,
    "message_validation_precedes_scan": true,
    "exact_validated_bytes_scanned": true,
    "exact_authorized_bytes_serialized_to_provider_mime": true,
    "only_current_authoritative_clean_may_reach_provider_write": true,
    "malicious_suspicious_unknown_unsupported_block_before_provider": true,
    "scanner_unavailable_blocks_before_provider": true,
    "resource_ids_content_bound_and_opaque": true,
    "resource_ids_exclude_raw_attachment_names_content_and_user_identifiers": true,
    "provenance_persistence_precedes_provider_client_creation": true,
    "provenance_persistence_failure_blocks_provider_write": true,
    "non_attachment_writes_unchanged": true
  },
  "outgoing_durable_scan_provenance": {
    "implemented": true,
    "storage": "private_operation_sidecar_json",
    "schema_version": 1,
    "atomic_write": true,
    "file_mode": "0600",
    "size_bounded": true,
    "max_bytes": 131072,
    "integrity_sha256": true,
    "operation_id_binding": true,
    "operation_id_is_opaque_sha256": true,
    "operation_id_exposes_raw_account_or_user_identifier": false,
    "clean_only": true,
    "stores_action": true,
    "stores_scan_record_id": true,
    "stores_correlation_id": true,
    "stores_producer_id": true,
    "stores_observed_at": true,
    "stores_valid_until": true,
    "stores_content_digest": true,
    "stores_opaque_resource_id": true,
    "stores_evidence_refs": true,
    "stores_attachment_filename": false,
    "stores_raw_attachment_content": false,
    "stores_recipient_address": false,
    "stores_provider_credentials": false,
    "stores_wardveil_caller_secrets": false,
    "persistence_failure_fails_closed_before_provider": true,
    "application_provenance_is_wardveil_audit": false,
    "integrity_sha256_is_production_security_signature": false,
    "production_authenticated_provenance_store_accepted": false
  },
  "result_mapping": {
    "clean": "allow_only_when_all_validation_passes",
    "suspicious": "hold_for_review_without_downloadable_cache_or_provider_write",
    "malicious": "block_and_request_quarantine_without_downloadable_cache_or_provider_write",
    "unknown": "block_unverified_without_downloadable_cache_or_provider_write",
    "unsupported": "block_unverified_without_downloadable_cache_or_provider_write"
  },
  "malicious_digest_match_remains_blocking_after_evidence_expiry": true,
  "quarantine": {
    "requires_explicit_executor_authority": true,
    "is_deletion": false,
    "mail_consumer_executes_quarantine_directly": false
  },
  "privacy": {
    "raw_attachment_content_in_shared_security_records": false,
    "credentials_or_provider_tokens_in_security_records": false,
    "data_minimization_required": true
  },
  "production_runtime_status": "unaccepted"
}
